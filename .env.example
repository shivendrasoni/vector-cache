# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Embeddings / LLM used by the examples
OPENAI_API_KEY=

# --- Semantic cache judge (System One model) -------------------------------
# Verifies grey-zone cache hits (similarity between judge_band floor and ceiling)
# before a cached answer is served. See README "Verifying hits with a System One judge".

# TypeSafe Jev (default). Get a key at https://typesafe.ai
TYPESAFE_API_KEY=

# Optional. Defaults to jev-latest. Pin a version (e.g. jev-1.13.0) for reproducible verdicts.
TYPESAFE_MODEL=

# Optional. Defaults to https://api.typesafe.ai/v1/systemone.
# Any System One model works here (Jev, Laaya, or another), as long as it is served
# behind the same /v1/systemone request shape: set TYPESAFE_API_URL and TYPESAFE_MODEL to point at it.
# Models with a different API: subclass vector_cache.judges.BaseJudge instead.
TYPESAFE_API_URL=
